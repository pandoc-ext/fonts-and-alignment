Pandoc
  Meta
    { unMeta =
        fromList
          [ ( "author"
            , MetaString
                "Nandakumar Chandrasekhar"
            )
          , ( "date"
            , MetaString
                "2026-05-25"
            )
          , ( "title"
            , MetaInlines
                [ Str "Text"
                , Space
                , Str "Casing"
                , Space
                , Str
                    "Transformations"
                , Space
                , Str "in"
                , Space
                , Str
                    "Bracketed"
                , Space
                , Str "Spans"
                ]
            )
          ]
    }
  [ Header
      2
      ( "uppercase"
      , []
      , []
      )
      [ Str "Uppercase" ]
  , CodeBlock
      ( ""
      , [ "markdown" ]
      , []
      )
      "[grumpy wizards make toxic brew.]{.pfa-uppercase}"
  , Para
      [ Span
          ( ""
          , [ "pfa-uppercase"
            ]
          , []
          )
          [ Str "GRUMPY"
          , Space
          , Str "WIZARDS"
          , Space
          , Str "MAKE"
          , Space
          , Str "TOXIC"
          , Space
          , Str "BREW."
          ]
      ]
  , Header
      2
      ( "lowercase"
      , []
      , []
      )
      [ Str "Lowercase" ]
  , CodeBlock
      ( ""
      , [ "markdown" ]
      , []
      )
      "[GRUMPY WIZARDS MAKE TOXIC BREW.]{.pfa-lowercase}"
  , Para
      [ Span
          ( ""
          , [ "pfa-lowercase"
            ]
          , []
          )
          [ Str "grumpy"
          , Space
          , Str "wizards"
          , Space
          , Str "make"
          , Space
          , Str "toxic"
          , Space
          , Str "brew."
          ]
      ]
  ]
