Pandoc
  Meta
    { unMeta =
        fromList
          [ ( "author"
            , MetaString
                "Nandakumar Chandrasekhar"
            )
          , ( "date"
            , MetaString
                "2026-05-25"
            )
          , ( "title"
            , MetaInlines
                [ Str
                    "Combining"
                , Space
                , Str "Inline"
                , Space
                , Str "Styles"
                ]
            )
          ]
    }
  [ Header
      2
      ( "bold-sans-display"
      , []
      , []
      )
      [ Str "Bold"
      , Space
      , Str "Sans"
      , Space
      , Str "Display"
      ]
  , CodeBlock
      ( ""
      , [ "markdown" ]
      , []
      )
      "[Grumpy wizards make toxic brew.]{.pfa-font-bold .pfa-font-sans .pfa-text-l pfa-font-color=\"red\"}"
  , Para
      [ Span
          ( ""
          , [ "pfa-font-bold"
            , "pfa-font-sans"
            , "pfa-text-l"
            ]
          , [ ( "style"
              , "color: #FF0000;"
              )
            ]
          )
          [ Str "Grumpy"
          , Space
          , Str "wizards"
          , Space
          , Str "make"
          , Space
          , Str "toxic"
          , Space
          , Str "brew."
          ]
      ]
  , Header
      2
      ( "italic-mono-caption"
      , []
      , []
      )
      [ Str "Italic"
      , Space
      , Str "Mono"
      , Space
      , Str "Caption"
      ]
  , CodeBlock
      ( ""
      , [ "markdown" ]
      , []
      )
      "[Grumpy wizards make toxic brew.]{.pfa-font-italic .pfa-font-mono .pfa-text-s}"
  , Para
      [ Span
          ( ""
          , [ "pfa-font-italic"
            , "pfa-font-mono"
            , "pfa-text-s"
            ]
          , []
          )
          [ Str "Grumpy"
          , Space
          , Str "wizards"
          , Space
          , Str "make"
          , Space
          , Str "toxic"
          , Space
          , Str "brew."
          ]
      ]
  , Header
      2
      ( "smallcaps-underline"
      , []
      , []
      )
      [ Str "Smallcaps"
      , Space
      , Str "Underline"
      ]
  , CodeBlock
      ( ""
      , [ "markdown" ]
      , []
      )
      "[Grumpy wizards make toxic brew.]{.pfa-text-uline .pfa-font-smallcaps pfa-font-color=\"forestgreen\"}"
  , Para
      [ Span
          ( ""
          , [ "pfa-text-uline"
            , "pfa-font-smallcaps"
            ]
          , [ ( "style"
              , "color: #228B22;"
              )
            ]
          )
          [ Underline
              [ Str "Grumpy"
              , Space
              , Str "wizards"
              , Space
              , Str "make"
              , Space
              , Str "toxic"
              , Space
              , Str "brew."
              ]
          ]
      ]
  ]
