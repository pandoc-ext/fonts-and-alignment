Pandoc
  Meta
    { unMeta =
        fromList
          [ ( "author"
            , MetaInlines
                [ Str
                    "Nandakumar"
                , Space
                , Str
                    "Chandrasekhar"
                ]
            )
          , ( "date"
            , MetaInlines
                [ Str "15"
                , Space
                , Str "May"
                , Space
                , Str "2026"
                ]
            )
          , ( "geometry"
            , MetaList
                [ MetaInlines
                    [ Str
                        "margin=25mm"
                    ]
                ]
            )
          , ( "linestretch"
            , MetaInlines
                [ Str "1.25" ]
            )
          , ( "papersize"
            , MetaInlines
                [ Str "A4" ]
            )
          , ( "title"
            , MetaInlines
                [ Str
                    "Combining"
                , Space
                , Str "Inline"
                , Space
                , Str "Styles"
                ]
            )
          ]
    }
  [ Header
      2
      ( "small-capitals-bold-and-italic"
      , []
      , []
      )
      [ Str "Small"
      , Space
      , Str "Capitals,"
      , Space
      , Str "Bold,"
      , Space
      , Str "and"
      , Space
      , Str "Italic"
      ]
  , Para
      [ Span
          ( ""
          , [ "pfa-font-smallcaps"
            , "pfa-font-bold"
            , "pfa-font-italic"
            ]
          , []
          )
          [ Str "The"
          , Space
          , Str "quick"
          , Space
          , Str "brown"
          , Space
          , Str "fox"
          , Space
          , Str "jumps"
          , Space
          , Str "over"
          , Space
          , Str "the"
          , Space
          , Str "lazy"
          , Space
          , Str "dog."
          ]
      ]
  , Header
      2
      ( "extra-small-bold-and-monospace"
      , []
      , []
      )
      [ Str "Extra"
      , Space
      , Str "Small,"
      , Space
      , Str "Bold,"
      , Space
      , Str "and"
      , Space
      , Str "Monospace"
      ]
  , Para
      [ Span
          ( ""
          , [ "pfa-text-xs"
            , "pfa-font-bold"
            , "pfa-font-mono"
            ]
          , []
          )
          [ Str "The"
          , Space
          , Str "quick"
          , Space
          , Str "brown"
          , Space
          , Str "fox"
          , Space
          , Str "jumps"
          , Space
          , Str "over"
          , Space
          , Str "the"
          , Space
          , Str "lazy"
          , Space
          , Str "dog."
          ]
      ]
  , Header
      2
      ( "sans-serif-italic-and-colored"
      , []
      , []
      )
      [ Str "Sans-serif,"
      , Space
      , Str "Italic,"
      , Space
      , Str "and"
      , Space
      , Str "Colored"
      ]
  , Para
      [ Span
          ( ""
          , [ "pfa-font-sans"
            , "pfa-font-italic"
            ]
          , [ ( "style"
              , "color: #1E90FF;"
              )
            ]
          )
          [ Str "The"
          , Space
          , Str "quick"
          , Space
          , Str "brown"
          , Space
          , Str "fox"
          , Space
          , Str "jumps"
          , Space
          , Str "over"
          , Space
          , Str "the"
          , Space
          , Str "lazy"
          , Space
          , Str "dog."
          ]
      ]
  ]
