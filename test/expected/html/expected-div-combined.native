[ Header
    2
    ( "bold-sans-serif" , [] , [] )
    [ Str "Bold" , Space , Str "Sans-serif" ]
, CodeBlock
    ( "" , [ "markdown" ] , [] )
    "::: {.pfa-font-bold .pfa-font-sans .pfa-text-l pfa-font-color=\"red\"}\nLorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\n:::"
, Div
    ( ""
    , [ "pfa-font-bold" , "pfa-font-sans" , "pfa-text-l" ]
    , [ ( "pfa-font-color" , "red" ) ]
    )
    [ Para
