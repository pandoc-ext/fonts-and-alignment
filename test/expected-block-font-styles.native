Pandoc
  Meta
    { unMeta =
        fromList
          [ ( "author"
            , MetaInlines
                [ Str
                    "Nandakumar"
                , Space
                , Str
                    "Chandrasekhar"
                ]
            )
          , ( "date"
            , MetaInlines
                [ Str "15"
