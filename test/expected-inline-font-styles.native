Pandoc
  Meta
    { unMeta =
        fromList
          [ ( "author"
            , MetaInlines
                [ Str
                    "Nandakumar"
                , Space
                , Str
                    "Chandrasekhar"
                ]
            )
          , ( "date"
            , MetaInlines
                [ Str "15"
                , Space
                , Str "May"
                , Space
                , Str "2026"
                ]
            )
          , ( "geometry"
            , MetaList
                [ MetaInlines
                    [ Str
                        "margin=25mm"
                    ]
                ]
            )
          , ( "linestretch"
            , MetaInlines
                [ Str "1.25" ]
            )
          , ( "papersize"
            , MetaInlines
                [ Str "A4" ]
            )
          , ( "title"
            , MetaInlines
                [ Str
                    "Styling"
                , Space
                , Str "Fonts"
                , Space
                , Str "Inline"
                ]
            )
          ]
    }
  [ Header
      2
      ( "bold" , [] , [] )
      [ Str "Bold" ]
