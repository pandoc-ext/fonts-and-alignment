Pandoc
  Meta
    { unMeta =
        fromList
          [ ( "author"
            , MetaInlines
                [ Str
                    "Nandakumar"
                , Space
                , Str
                    "Chandrasekhar"
                ]
            )
          , ( "date"
            , MetaInlines
                [ Str "15"
                , Space
                , Str "May"
                , Space
                , Str "2026"
                ]
            )
          , ( "geometry"
            , MetaList
                [ MetaInlines
                    [ Str
                        "margin=25mm"
                    ]
                ]
            )
          , ( "linestretch"
            , MetaInlines
                [ Str "1.25" ]
            )
          , ( "papersize"
            , MetaInlines
                [ Str "A4" ]
            )
          , ( "title"
            , MetaInlines
                [ Str
                    "Underlining"
                , Space
                , Str "Inline"
                , Space
                , Str
                    "Elements"
                ]
            )
          ]
    }
  [ Header
      2
      ( "standard-underline"
      , []
      , []
      )
      [ Str "Standard"
      , Space
      , Str "Underline"
      ]
