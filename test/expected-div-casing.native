Pandoc
  Meta
    { unMeta =
        fromList
          [ ( "author"
            , MetaString
                "Nandakumar Chandrasekhar"
            )
          , ( "date"
            , MetaString
                "2026-05-25"
            )
          , ( "title"
            , MetaInlines
                [ Str "Text"
                , Space
                , Str "Casing"
                , Space
                , Str
                    "Transformations"
                , Space
                , Str "in"
                , Space
                , Str "Fenced"
                , Space
                , Str "Divs"
                ]
            )
          ]
    }
  [ Header
      2
      ( "uppercase"
      , []
      , []
      )
      [ Str "Uppercase" ]
  , CodeBlock
      ( ""
      , [ "markdown" ]
      , []
      )
      "::: {.pfa-uppercase}\nlorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\n:::"
  , Div
      ( ""
      , [ "pfa-uppercase" ]
      , []
      )
      [ Para
          [ Str "LOREM"
          , Space
          , Str "IPSUM"
          , Space
          , Str "DOLOR"
          , Space
          , Str "SIT"
          , Space
          , Str "AMET,"
          , Space
          , Str "CONSECTETUR"
          , Space
          , Str "ADIPISCING"
          , Space
          , Str "ELIT,"
          , Space
          , Str "SED"
          , Space
          , Str "DO"
          , Space
          , Str "EIUSMOD"
          , Space
          , Str "TEMPOR"
          , Space
          , Str "INCIDIDUNT"
          , Space
          , Str "UT"
          , Space
          , Str "LABORE"
          , Space
          , Str "ET"
          , Space
          , Str "DOLORE"
          , Space
          , Str "MAGNA"
          , Space
          , Str "ALIQUA."
          ]
      ]
  , Header
      2
      ( "lowercase"
      , []
      , []
      )
      [ Str "Lowercase" ]
  , CodeBlock
      ( ""
      , [ "markdown" ]
      , []
      )
      "::: {.pfa-lowercase}\nLOREM IPSUM DOLOR SIT AMET, CONSECTETUR ADIPISCING ELIT, SED DO EIUSMOD TEMPOR INCIDIDUNT UT LABORE ET DOLORE MAGNA ALIQUA.\n:::"
  , Div
      ( ""
      , [ "pfa-lowercase" ]
      , []
      )
      [ Para
          [ Str "lorem"
          , Space
          , Str "ipsum"
          , Space
          , Str "dolor"
          , Space
          , Str "sit"
          , Space
          , Str "amet,"
          , Space
          , Str "consectetur"
          , Space
          , Str "adipiscing"
          , Space
          , Str "elit,"
          , Space
          , Str "sed"
          , Space
          , Str "do"
          , Space
          , Str "eiusmod"
          , Space
          , Str "tempor"
          , Space
          , Str "incididunt"
          , Space
          , Str "ut"
          , Space
          , Str "labore"
          , Space
          , Str "et"
          , Space
          , Str "dolore"
          , Space
          , Str "magna"
          , Space
          , Str "aliqua."
          ]
      ]
  ]
